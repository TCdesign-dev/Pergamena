# ─────────────────────────────────────────────────────────────────────
#  PERGAMENA — chiavi API
#
#      cp .env.example .env.local
#
#  `.env.local` è ignorato da git: le chiavi non finiscono mai in un
#  commit. Non incollarle mai in chat: si mettono solo qui.
#
#  REGOLA: ciò che comincia per VITE_ finisce dentro al programma che
#  gira nel browser, quindi è PUBBLICO. Tutto il resto resta sul tuo
#  computer. Per questo la chiave di OpenRouter non ha il prefisso.
# ─────────────────────────────────────────────────────────────────────


# ══ SERVE ADESSO — fase 1b: sincronizzazione e telefono ══════════════
#
#  ┌─ Come si prendono ─────────────────────────────────────────────┐
#  │ 1. supabase.com › Start your project › accedi con GitHub       │
#  │ 2. New project — nome «pergamena», regione Frankfurt o Milano, │
#  │    scegli una password del database e SALVALA da qualche parte  │
#  │    (a noi non serve, ma senza non rientri più)                  │
#  │ 3. aspetta un paio di minuti che finisca di crearsi             │
#  │ 4. in alto a sinistra: Project Settings (l'ingranaggio)         │
#  │ 5. voce «API Keys» (nei progetti più vecchi si chiama «API»)    │
#  │ 6. copia i due valori qui sotto                                 │
#  └────────────────────────────────────────────────────────────────┘
#
#  L'indirizzo del progetto. Finisce per .supabase.co
#  NON è la «connection string» del database (quella che comincia con
#  postgresql://): serve a un server, e noi non ne abbiamo uno.
VITE_SUPABASE_URL=
#
#  La chiave PUBBLICA. Sull'etichetta c'è scritto «anon public»,
#  oppure «Publishable key» nei progetti nuovi. Comincia per
#  eyJ... o per sb_publishable_...
#  È fatta apposta per stare dentro al programma: non è un segreto.
VITE_SUPABASE_ANON_KEY=
#
#  NON serve la «service_role» / «secret key». Quella scavalca ogni
#  regola di accesso, e in un'app senza server non avrebbe dove stare
#  al sicuro. Se te la sei già copiata da qualche parte, cancellala.


# ══ SERVE PIÙ AVANTI — fase 3: merge dopo la lezione ═════════════════
#
#  openrouter.ai › accedi › Keys › Create key
#  Una sola chiave copre merge, quiz e anche Jev.
#  Niente prefisso VITE_, quindi non entra mai nel browser.
OPENROUTER_API_KEY=
#
#  ┌─ Il tetto di 50 chiamate al giorno ─────────────────────────────┐
#  │ Vale SOLO per i modelli col suffisso :free — non per la chiave. │
#  │ I modelli a consumo qui sotto non ci rientrano, ma vogliono     │
#  │ del credito sul conto.                                          │
#  │                                                                 │
#  │ $10 una volta sola alzano il tetto dei :free a 1000/giorno PER  │
#  │ SEMPRE (conta l'acquisto a vita, non il saldo) e pagano i       │
#  │ modelli a consumo. Ai nostri consumi bastano per oltre un anno. │
#  └─────────────────────────────────────────────────────────────────┘
#
#  I modelli si cambiano da qui, non dal codice.
#
#  A consumo — prezzo verificato il 20/09/2026, 1 milione di contesto:
#  $0,036 per milione in ingresso, $0,071 in uscita. Sono circa dieci
#  centesimi al mese ai tuoi ritmi.
MODELLO_MERGE=deepseek/deepseek-v4-flash
MODELLO_QUIZ=deepseek/deepseek-v4-flash
MODELLO_VELOCE=deepseek/deepseek-v4-flash
#
#  Alternative a costo zero, se preferisci restare dentro alle 50/giorno.
#  Le proviamo sul merge vero quando arriviamo alla fase 3:
#    nvidia/nemotron-3.5-lightning:free      (1 milione di contesto)
#    thinkingmachines/inkling-small:free     (1 milione)
#    dots-studio/dots-3-note-preview:free    (512k)
#  Attenzione: i modelli :free di solito permettono al fornitore di
#  usare quello che gli mandi. Sono i tuoi appunti: decidi tu.
#
#  Jev NON passa dalle chat completions: su OpenRouter ha un endpoint
#  suo, POST /api/alpha/decisions, che conserva le domande tipizzate.
#  Per questo non compare nell'elenco dei modelli. Nessuna versione
#  gratuita esiste, né qui né altrove: la fase 5 vuole del credito.
MODELLO_TRIAGE=typesafe/jev-1.13


# ══ NON SERVE NIENTE ═════════════════════════════════════════════════
#
#  Trascrizione — SpeechTranscriber di macOS 26, sul tuo Mac.
#                 Il modello italiano è già installato.
#  Immagini     — Wikimedia Commons è aperto.
#  Jev          — la chiave di TypeSafe NON serve. Il loro accesso
#                 diretto è dietro lista d'attesa, costa uguale
#                 ($0,042 per milione, uscita gratis) e OpenRouter
#                 non perde niente per strada, perché ha un endpoint
#                 dedicato alle decisioni. Se un giorno la vuoi
#                 lo stesso, la riga è fra le opzionali.


# ══ OPZIONALI — solo se un giorno bypassi OpenRouter ═════════════════
#
#  Utili per la latenza, o per tenere i dati fuori dalla Cina.
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
#
#  Immagini dal web (pannello Immagini → «Web»). Senza chiavi si usa
#  Openverse: immagini libere da tutto il web, gratis. Con la chiave di
#  Serper arrivano i risultati di Google Immagini (l'API ufficiale di
#  Google è chiusa ai nuovi utenti): serper.dev, 2.500 ricerche gratis
#  senza carta di credito, poi circa 1 $ ogni 1.000. Brave in alternativa.
SERPER_API_KEY=
BRAVE_API_KEY=
#
#  TypeSafe diretto: serve solo se un giorno vuoi togliere OpenRouter
#  di mezzo per guadagnare qualche decina di millisecondi sul live.
#  typesafe.ai — lista d'attesa.
TYPESAFE_API_KEY=

# ── Solo per una copia di prova dell'app ─────────────────────────────
# Dove mettere audio e frasi sospese. Lasciala vuota per l'app vera
# (~/Library/Application Support/Pergamena); una copia di prova DEVE
# averne una sua, o potrebbe prendersi i file di una lezione vera.
PERGAMENA_CARTELLA=
# Accesa, l'app si mostra come copia di prova (bordo arancio): per la
# copia con cui si collauda, mai per quella vera.
VITE_COPIA_DI_PROVA=
